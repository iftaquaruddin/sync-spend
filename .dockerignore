# Node dependencies and logs
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Git repository
.git/
.gitignore

# SQLite databases (data should only live in mounted volumes)
*.db
*.db-journal
*.sqlite
*.sqlite3
server/expenses.db
server/expenses.db-journal

# Receipt image uploads (stored in mounted volume)
server/uploads/receipts/*
!server/uploads/receipts/.gitkeep

# Mobile application source & build files
mobile_app/
.dart_tool/
build/
*.apk
*.sha1

# Documentation and temporary scripts
docs/
*.md
*.ps1

# Environment and editor files
.env
.env.*
!.env.example
.idea/
.vscode/
*.swp
*.bak
.DS_Store
Thumbs.db
