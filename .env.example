# =============================================================
# SyncSpend Pro • Environment Configuration Template
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# =============================================================

# Port to expose on the host machine
PORT=3000

# Strong random secret key used to sign JWT authentication tokens
JWT_SECRET=replace_with_a_secure_random_jwt_secret_key_for_production

# Optional: Host IP or Domain name (e.g. 192.168.1.150 or expense.myhome.net)
# SERVER_HOST=192.168.1.150

# Node environment (production / development)
NODE_ENV=production
